import numpy as np
from fastdtw import fastdtw
from scipy.spatial.distance import euclidean

# Function to generate candidate trajectories (example)
def generate_candidate_trajectories(bounds, num_trajectories=10, length=50):
    # Generate random trajectories within the bounds for demonstration
    trajectories = []
    for _ in range(num_trajectories):
        trajectory = np.cumsum(np.random.randn(length, 2), axis=0)  # Random walk
        trajectory = np.clip(trajectory, bounds[0], bounds[1])  # Clip to bounds
        trajectories.append(trajectory)
    return trajectories

# Function to compute DTW distance
def compute_dtw_distance(predicted_trajectory, candidate_trajectory):
    distance, path = fastdtw(predicted_trajectory, candidate_trajectory, dist=euclidean)
    return distance

# Example predicted trajectory from IMU data (random data for demonstration)
predicted_trajectory = np.cumsum(np.random.randn(50, 2), axis=0)

# Define bounds (example)
bounds = np.array([[0, 0], [10, 10]])

# Generate candidate trajectories
candidate_trajectories = generate_candidate_trajectories(bounds)

# Compute DTW cost for each candidate trajectory
dtw_costs = []
for candidate_trajectory in candidate_trajectories:
    cost = compute_dtw_distance(predicted_trajectory, candidate_trajectory)
    dtw_costs.append(cost)

# Select the best trajectory with the lowest DTW cost
best_trajectory_index = np.argmin(dtw_costs)
best_trajectory = candidate_trajectories[best_trajectory_index]

print(f"Best trajectory index: {best_trajectory_index}")
print(f"DTW cost: {dtw_costs[best_trajectory_index]}")

# Plot the predicted trajectory and the best matched trajectory
import matplotlib.pyplot as plt

plt.plot(predicted_trajectory[:, 0], predicted_trajectory[:, 1], label='Predicted Trajectory')
plt.plot(best_trajectory[:, 0], best_trajectory[:, 1], label='Best Matched Trajectory')
plt.legend()
plt.show()



import numpy as np
from fastdtw import fastdtw
from scipy.spatial.distance import euclidean
import matplotlib.pyplot as plt

# Function to generate a circular trajectory
def generate_circular_trajectory(radius, num_points=50):
    angles = np.linspace(0, 2 * np.pi, num_points)
    return np.array([radius * np.cos(angles), radius * np.sin(angles)]).T

# Function to generate candidate trajectories within bounds and considering map
def generate_candidate_trajectories(bounds, heatmap, num_trajectories=10, length=50):
    trajectories = []
    for _ in range(num_trajectories):
        trajectory = []
        for i in range(length):
            lower_bound, upper_bound = bounds[i]
            point = np.random.uniform(lower_bound, upper_bound)
            while not is_point_valid(point, heatmap):
                point = np.random.uniform(lower_bound, upper_bound)
            trajectory.append(point)
        trajectories.append(np.array(trajectory))
    return trajectories

# Function to check if a point is valid based on the heatmap
def is_point_valid(point, heatmap):
    x, y = int(point[0]), int(point[1])
    if 0 <= x < heatmap.shape[0] and 0 <= y < heatmap.shape[1]:
        return heatmap[x, y] < 1  # Threshold for free space, adjust based on your heatmap
    return False

# Function to compute DTW distance
def compute_dtw_distance(predicted_trajectory, candidate_trajectory):
    distance, path = fastdtw(predicted_trajectory, candidate_trajectory, dist=euclidean)
    return distance

# Generate predicted trajectory as a circle of radius 2
predicted_trajectory = generate_circular_trajectory(4, num_points=50)

# Generate bounds as circles of radii 1 and 3
lower_bounds = generate_circular_trajectory(3, num_points=50)
upper_bounds = generate_circular_trajectory(5, num_points=50)
bounds = [(lower_bounds[i], upper_bounds[i]) for i in range(50)]

# Generate a heatmap with high intensities in the center
heatmap_size = 20
x, y = np.meshgrid(np.linspace(-heatmap_size // 2, heatmap_size // 2, heatmap_size), 
                   np.linspace(-heatmap_size // 2, heatmap_size // 2, heatmap_size))
heatmap = np.exp(-(x**2 + y**2) / (2 * (heatmap_size // 3)**2))
print(heatmap.max())
print(heatmap.min())
# Generate candidate trajectories
candidate_trajectories = generate_candidate_trajectories(bounds, heatmap)

# Compute DTW cost for each candidate trajectory
dtw_costs = []
for candidate_trajectory in candidate_trajectories:
    cost = compute_dtw_distance(predicted_trajectory, candidate_trajectory)
    dtw_costs.append(cost)

# Select the best trajectory with the lowest DTW cost
best_trajectory_index = np.argmin(dtw_costs)
best_trajectory = candidate_trajectories[best_trajectory_index]

print(f"Best trajectory index: {best_trajectory_index}")
print(f"DTW cost: {dtw_costs[best_trajectory_index]}")

# Plot the predicted trajectory, the best matched trajectory, and the heatmap
plt.imshow(heatmap.T, origin='lower', cmap='hot', interpolation='nearest', extent=[-heatmap_size//2, heatmap_size//2, -heatmap_size//2, heatmap_size//2])
plt.plot(predicted_trajectory[:, 0], predicted_trajectory[:, 1], label='Predicted Trajectory')
plt.plot(best_trajectory[:, 0], best_trajectory[:, 1], label='Best Matched Trajectory')
plt.legend()
plt.show()







